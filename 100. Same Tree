class Solution {
    public boolean isSameTree(TreeNode p, TreeNode q) {
        // Base case 1: Both nodes are null, trees are the same
        if (p == null && q == null) {
            return true;
        }
        
        // Base case 2: One node is null and the other is not, trees are not the same
        if (p == null || q == null) {
            return false;
        }
        
        // Base case 3: Check if the values are the same and recursively check left and right subtrees
        if (p.val != q.val) {
            return false;
        }
        
        // Recursively check the left and right subtrees
        return isSameTree(p.left, q.left) && isSameTree(p.right, q.right);
    }
}
