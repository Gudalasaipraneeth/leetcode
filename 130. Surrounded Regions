class Solution {
    public void solve(char[][] board) {
        int n= board.length;
        if(n==0)
        return ;
        int m = board[0].length;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(i==0||j==0||i==n-1||j==m-1){
                    if(board[i][j]=='O'){
                        bfs(board, i,j,n,m);
                    }
                }
            }
        }
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                    if(board[i][j]=='O'){
                        board[i][j]='X';
                    }
            
            }
        }
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                 if(board[i][j]=='T'){
                        board[i][j]='O';
                    }
            }
        }
    }

    public void bfs(char[][] board, int i, int j, int n, int m){
        Deque<int[]> q= new LinkedList<>();
        q.offer(new int[]{i,j});
        while(!q.isEmpty()){
            int[] arr= q.poll();
            int a=arr[0], b=arr[1];
            if(a<0||b<0||a>n-1||b>m-1 || board[a][b]!='O'){
                continue;
            }
            board[a][b]= 'T';
            q.push(new int[]{a-1,b});
            q.push(new int[]{a, b-1});
            q.push(new int[]{a+1,b});
            q.push(new int[]{a, b+1});
        }
    }
}
