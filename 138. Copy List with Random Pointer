class Solution {
    public Node copyRandomList(Node head) {
        if (head == null) return null;

        // 1) Interleave cloned nodes after each original node
        Node curr = head;
        while (curr != null) {
            Node copy = new Node(curr.val);
            copy.next = curr.next;
            curr.next = copy;
            curr = copy.next;
        }

        // 2) Set random for cloned nodes
        curr = head;
        while (curr != null) {
            Node copy = curr.next;
            copy.random = (curr.random != null) ? curr.random.next : null;
            curr = copy.next;
        }

        // 3) Unweave into original and copied lists
        curr = head;
        Node pseudoHead = head.next;
        while (curr != null) {
            Node copy = curr.next;
            curr.next = copy.next;                // restore original next
            copy.next = (copy.next != null) ? copy.next.next : null; // link copy→copy
            curr = curr.next;
        }
        return pseudoHead;
    }
}
