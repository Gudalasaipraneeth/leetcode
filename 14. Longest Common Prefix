class Solution {
    public String longestCommonPrefix(String[] strs) {
        String pre=strs[0];
        for(int i=1;i<strs.length;i++){
            int n=Math.min(pre.length(),strs[i].length());
            StringBuilder s= new StringBuilder();
            String curr= strs[i];
            for(int j=0;j<n;j++){
                char ch1=pre.charAt(j);
                char ch2=curr.charAt(j);
                if(ch1==ch2){
                    s.append(ch1);
                }
                else
                  break;
            }
            pre=s.toString();

        }
        return pre;
    }
}
