class Solution {
    public String reverseWords(String s) {
        int end=-1;
        StringBuilder str= new StringBuilder();
        for(int i=s.length()-1;i>=0;i--){
            char ch=s.charAt(i);
            if(ch!=' ' && end==-1){
                end=i;
            }
            if((ch==' ' || i==0) && end!=-1){
                int start= (ch==' ')? i+1:i;
                str.append(s.substring(start,end+1));
                str.append(" ");
                end=-1;
            }
            
        }
        str.deleteCharAt(str.length()-1);
        return str.toString();
    }
}
