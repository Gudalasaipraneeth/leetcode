class Solution {
    public int numIslands(char[][] grid) {
        int island=0;
        int n = grid.length;
        if(n==0)
        return 0;
        int m = grid[0].length;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(grid[i][j]=='1'){
                    island++;
                    bfs(grid, i,j,n,m);
                }
            }
        }
        return island;    
    }

    public void bfs(char[][] grid, int i, int j, int n, int m){
        Deque<int[]> q= new LinkedList<>();
        q.offer(new int[]{i,j});
        while(!q.isEmpty()){
            int []arr= q.pop();
            int a = arr[0], b=arr[1];
            if(a<0||a>n-1 || b<0||b>m-1 || grid[a][b]!='1'){
                continue;
            }
            grid[a][b]='0';
            q.offer(new int[]{a-1,b});
            q.offer(new int[]{a,b-1});
            q.offer(new int[]{a+1,b});
            q.offer(new int[]{a,b+1});
        }
    }
}
