     public int findKthLargest(int[] nums, int k) {
        PriorityQueue<Integer> minHeap = new PriorityQueue<>(k);
        for (int x : nums) {
            if (minHeap.size() < k) {
                minHeap.offer(x);
            } else if (x > minHeap.peek()) {
                minHeap.poll();
                minHeap.offer(x);
            }
        }
        return minHeap.peek();
    }
