class Solution {
    public int[] searchRange(int[] nums, int target) {
        int[] result = new int[]{-1,-1};
        int leftBound= find(nums, target,  true);
        if(leftBound==-1)
        return result;

        result[0]= leftBound;
        result[1]= find(nums,target, false);
        return result;
    }

    public int find(int[] nums, int target, boolean findFirst){
        int l=0;
        int r= nums.length-1;
        
        int bound=-1;
        while(l<=r){
            int mid= l+(r-l)/2;
            if(target== nums[mid]){
                bound=mid;
                if(findFirst){
                    r=mid-1;
                }
                else{
                    l=mid+1;
                }
            }
            else if(target<=nums[mid]){
                r=mid-1;
            }
            else{
                l=mid+1;
            }
        }
        return bound;
    }
}
