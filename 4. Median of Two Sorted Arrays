class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        if (nums1.length > nums2.length)
            return findMedianSortedArrays(nums2, nums1);

        int m = nums1.length;
        int n = nums2.length;
        int low = 0, high = m; 
        while (low <= high) {
            int i = low + (high - low) / 2; //1
            int j = (m + n + 1) / 2 - i;      

            int nums1L = (i == 0) ? Integer.MIN_VALUE : nums1[i - 1]; 
            int nums1R = (i == m) ? Integer.MAX_VALUE : nums1[i];     
            int nums2L = (j == 0) ? Integer.MIN_VALUE : nums2[j - 1]; 
            int nums2R = (j == n) ? Integer.MAX_VALUE : nums2[j];     

            if (nums1L <= nums2R && nums2L <= nums1R) {
                if ((m + n) % 2 == 1)
                    return Math.max(nums1L, nums2L);  
                else
                    return (Math.max(nums1L, nums2L) + Math.min(nums1R, nums2R)) / 2.0; 
            } else if (nums1L > nums2R) {
                high = i - 1;
            } else {
                low = i + 1;
            }
        }
        return 0.0;
    }
}
