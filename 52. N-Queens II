class Solution {
      int count =0;
    public int totalNQueens(int n) {
        if(n==0)
        return 0;
        Set<Integer> cols= new HashSet();
        Set<Integer> diag1= new HashSet();
        Set<Integer> diag2= new HashSet();
      
        backtrack(n, 0, cols, diag1, diag2);
        return count;
    }
    public void backtrack(int n, int r, Set<Integer> cols, Set<Integer> diag1, Set<Integer> diag2 ){
        if(r==n){
            count++;
            return;
        }
        for(int c=0;c<n;c++){
            int d1= r+c;
            int d2= r-c;
            if(cols.contains(c) || diag1.contains(d1) || diag2.contains(d2))
            continue;

            cols.add(c);
            diag1.add(d1);
            diag2.add(d2);
            backtrack(n, r+1, cols, diag1, diag2);
            cols.remove(c);
            diag1.remove(d1);
            diag2.remove(d2);
        }
         
    }
}
