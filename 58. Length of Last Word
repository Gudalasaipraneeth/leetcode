class Solution {
    public int lengthOfLastWord(String s) {
        int c = 0;
        for (int i = s.length() - 1; i >= 0; i--) {
            char ch = s.charAt(i);
            if (s.charAt(i) != ' ') {
                while (i >= 0 && s.charAt(i) != ' ') {
                    c++;
                    i--;
                }
                return c;
            }
        }
        return 0;
    }
}
