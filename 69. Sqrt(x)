
class Solution {
    public int mySqrt(int x) {
        if (x < 2) return x;
        int l = 1, r = x / 2, last = 0;
        while (l <= r) {
            int mid = l + (r - l) / 2;
            long sq = (long) mid * mid;        // avoid overflow
            if (sq == x) {
                return mid;
            } else if (sq > x) {
                r = mid - 1;
            } else {
                last = mid;
                l = mid + 1;
            }
        }
        return last;
    }
}
