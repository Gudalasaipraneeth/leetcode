def simplifyPath(path: str) -> str:
    stack = []
    n = len(path)
    i = 0

    while i < n:
        # Skip consecutive slashes
        while i < n and path[i] == '/':
            i += 1
        if i >= n:
            break

        # Read the next component [i, j)
        j = i
        while j < n and path[j] != '/':
            j += 1
        comp = path[i:j]

        if comp == '.':
            pass  # current directory -> ignore
        elif comp == '..':
            if stack:
                stack.pop()  # go up one level if possible
        else:
            # Any other name (including strings like '...' or '....') is valid
            stack.append(comp)

        i = j  # continue scanning from the slash

    return '/' + '/'.join(stack)
