class Solution {
    public List<List<Integer>> combine(int n, int k) {
        List<List<Integer>> result = new ArrayList<>();
        if(n==0||k==0)
        return result;
        backtrack(n,k, result, 1, new ArrayList<>());
        return result;
    }
    public void backtrack(int n, int k,  List<List<Integer>> result, int start, List<Integer> list ){
        if(list.size()==k){
            result.add(new ArrayList<>(list));
            return;
        }
        for(int i=start;i<=n;i++){
            list.add(i);
            backtrack(n,k, result,i+1, list);
            list.remove(list.size()-1);
        }
    }
}
