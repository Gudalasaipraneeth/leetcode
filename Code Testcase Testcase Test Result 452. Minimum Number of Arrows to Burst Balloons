class Solution {
    public int findMinArrowShots(int[][] points) {
        Arrays.sort(points,(a,b)->Integer.compare(a[1],b[1]));
        int[] prev= points[0];
        int count=points.length;
        for(int i=1;i<points.length;i++){
            int[] curr= points[i];
            if(prev[1]>=curr[0]){
                count--;
                prev=new int[]{curr[0], Math.min(curr[1], prev[1])};
            }
            else{
                prev=curr;
            }
        }
        return count;
    }
}
