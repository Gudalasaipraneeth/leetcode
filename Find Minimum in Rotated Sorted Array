class Solution {
    public int findMin(int[] nums) {
      int min= nums[0];
      int l=0;
      int r= nums.length-1;
      while(l<=r)
      {
        int m= (l+r)/2;
        if(nums[m]<nums[r]){
            r=m-1;
        }
        else {
            l=m+1;
        }
       min = Math.min(min, nums[m]);
      }  
      return min;
    }
}
