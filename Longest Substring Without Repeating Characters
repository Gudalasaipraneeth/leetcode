class Solution {
    public int lengthOfLongestSubstring(String s) {
        if (s == null) return 0;
        int[] last = new int[128]; 
        java.util.Arrays.fill(last, -1);

        int max = 0, l = 0;
        for (int i = 0; i < s.length(); i++) {
            int c = s.charAt(i);
            if (last[c] >= l) {
                l = last[c] + 1;        // jump left pointer past duplicate
            }
            last[c] = i;
            max = Math.max(max, i - l + 1);
        }
        return max;
    }
}
