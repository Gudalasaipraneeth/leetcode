class Solution {
    public String minWindow(String s, String t) {
          if (t.isEmpty()) return "";
          Map<Character, Integer> window= new HashMap<>();
          Map<Character, Integer> tmap= new HashMap<>();
          int resLength= Integer.MAX_VALUE;
            for(int i =0;i<t.length();i++){
                char c= t.charAt(i);
                tmap.put(c, tmap.getOrDefault(c,0)+1);
            }
        int have =0, need= tmap.size(), left=0;
        int[] res= {-1,-1};
            for(int i =0;i<s.length();i++){
                char c= s.charAt(i);
                window.put(c, window.getOrDefault(c,0)+1);
                if(tmap.containsKey(c) && tmap.get(c).equals(window.get(c))){
                    have++;
                }
                while(need==have){
                    if((i-left+1)< resLength){
                    resLength= i-left+1;
                    res[0]=left;
                    res[1]=i;
                    }

                    char leftChar= s.charAt(left);
                    window.put(leftChar, window.get(leftChar)-1);
                    if(tmap.containsKey(leftChar) && window.get(leftChar)<tmap.get(leftChar)){
                        have--;
                    }
                    left++;
                }
            }
            return resLength== Integer.MAX_VALUE?"":s.substring(res[0],res[1]+1);      
    }
}
