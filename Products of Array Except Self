class Solution {
    public int[] productExceptSelf(int[] nums) {
        int product = 1;
        int zeros=0;
        for(int i:nums){
            if(i!=0){
                product = product*i;
            }
            else
                zeros++;
        }
        int [] res= new int[nums.length];
        for(int i=0;i<nums.length;i++){
            if(zeros==1 && nums[i]==0)
                res[i]=product;
            else if(zeros==0)
                res[i]= product/nums[i];
            else
                res[i]=0;
           
        }
        return res;
    }
}  
